<?xml version="1.0"?>
<package format="2">
  <name>franka_panda_mtp</name>
  <version>0.1.0</version>
  <description>
    This package contains the python scripts and everything related to mtp.
  </description>

  <author email="schmittv@hs-pforzheim.de">Vincent Schmitt</author>
  <maintainer email="schmittv@hs-pforzheim.de">Vincent Schmitt</maintainer>
  <license>TODO</license>

  <!-- Build tool dependencies -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>rospy</build_depend>
  <build_depend>roslaunch</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>moveit_commander</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>moveit_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>franka_panda_communication</build_depend>

  <!-- Execution dependencies -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>franka_panda_communication</exec_depend>
</package>