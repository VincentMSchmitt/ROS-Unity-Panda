		<InterfaceClass Name="DataItem">
			<Description>Base Class for DataItems</Description>
			<Attribute Name="Access" AttributeDataType="xs:byte">
				<Description>[0]=NoAccess; [1]=Read; [2]=Write; [3]=Read/Write</Description>
			</Attribute>
			<InterfaceClass Name="OPCUAItem" RefBaseClassPath="MTPCommunicationICLib/DataItem">
				<Description>OPC UA typed Data Item</Description>
				<Attribute Name="Identifier" AttributeDataType="xs:string">
					<Description>OPC UA NodeID - IdentifierType(depends on AttributeDataType): xs: string = string; xs: ID = GUID; xs: Base64Binary = ByteArray; xs: int = Integer</Description>
				</Attribute>
				<Attribute Name="Namespace" AttributeDataType="xs:string">
					<Description>OPC UA Namespace</Description>
				</Attribute>
			</InterfaceClass>
		</InterfaceClass>
	</InterfaceClassLib>
